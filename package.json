{
  "name": "opencode-token-totals",
  "version": "0.1.0",
  "description": "Per-model token totals across every project on the device, with an incremental one-request-per-day cache",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-gui-plugin",
    "tokens",
    "usage",
    "analytics"
  ],
  "exports": {
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "validate": "bun run scripts/validate.ts"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.2.0"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode/client": "2.3.0",
    "@opencode/plugin": "2.3.0",
    "effect": "4.1.0",
    "solid-js": "^1.9.9",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "vite-plugin-solid": "^2.11.8"
  }
}
